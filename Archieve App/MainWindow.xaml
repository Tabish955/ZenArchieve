<ui:FluentWindow x:Class="Archieve_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Archieve_App"
        mc:Ignorable="d"
        Title="ZenArchive" Height="720" Width="1160"
        MinHeight="560" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <Grid>
        <!-- Main Window Rows -->
        <Grid.RowDefinitions>
            <!-- TitleBar Row -->
            <RowDefinition Height="Auto" />
            <!-- Toolbar / Header Row -->
            <RowDefinition Height="Auto" />
            <!-- Main Content (Drop zone / DataGrid / Inspector) Row -->
            <RowDefinition Height="*" />
            <!-- Bottom Progress & Status Bar Row -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Title Bar -->
        <ui:TitleBar Grid.Row="0"
                     Title="ZenArchive"
                     Height="40"
                     Padding="16,0,8,0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="FolderZip24" 
                                   FontSize="16" 
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                   Margin="0,0,8,0"/>
                    <TextBlock Text="ZenArchive" 
                               FontWeight="SemiBold" 
                               FontSize="13" 
                               VerticalAlignment="Center" 
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                            CornerRadius="4" 
                            Padding="6,1" 
                            Margin="10,0,0,0" 
                            VerticalAlignment="Center">
                        <TextBlock Text="v2.0 • Enterprise Pro" 
                                   FontSize="10" 
                                   FontWeight="Medium" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- 2. Action Toolbar & Stats Bar -->
        <Border Grid.Row="1" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="16,10,16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Action Buttons ScrollViewer (Horizontally scrollable for all screen sizes) -->
                <ScrollViewer Grid.Column="0" 
                              x:Name="ToolbarScrollViewer"
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Disabled"
                              Focusable="False"
                              Margin="0,0,12,0"
                              PanningMode="HorizontalOnly"
                              PreviewMouseWheel="ToolbarScrollViewer_PreviewMouseWheel">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                        <!-- Open Archive Button -->
                        <ui:Button x:Name="BtnOpenArchive" 
                                   Click="BtnOpenArchive_Click"
                                   Appearance="Secondary"
                                   ToolTip="Open and inspect an archive (.zip, .rar, .7z)"
                                   Margin="0,0,6,0" 
                                   Padding="10,7">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" FontSize="15"/>
                            <TextBlock Text="Open" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Create / New Archive Button -->
                    <ui:Button x:Name="BtnNewArchive" 
                               Click="BtnNewArchive_Click"
                               Appearance="Secondary"
                               ToolTip="Compress files or folders into a new .zip or .7z archive"
                               Margin="0,0,6,0" 
                               Padding="10,7">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="AddCircle24" Margin="0,0,6,0" FontSize="15" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="New Archive" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Extract Here Button -->
                    <ui:Button x:Name="BtnExtractHere" 
                               Click="BtnExtractHere_Click"
                               Appearance="Secondary"
                               IsEnabled="False"
                               ToolTip="Extract Here: Extracts archive contents directly into the archive's parent folder without creating extra subfolders"
                               Margin="0,0,6,0" 
                               Padding="10,7">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,6,0" FontSize="15"/>
                            <TextBlock Text="Extract Here" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Extract to Folder... Button -->
                    <ui:Button x:Name="BtnExtractTo" 
                               Click="BtnExtractTo_Click"
                               Appearance="Secondary"
                               IsEnabled="False"
                               ToolTip="Extract to Folder...: Choose any custom destination folder to extract archive contents into"
                               Margin="0,0,6,0" 
                               Padding="10,7">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="FolderZip24" Margin="0,0,6,0" FontSize="15"/>
                            <TextBlock Text="Extract to Folder..." FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Smart Extract Button -->
                    <ui:Button x:Name="BtnSmartExtract" 
                               Click="BtnSmartExtract_Click"
                               Appearance="Primary"
                               IsEnabled="False"
                               ToolTip="Smart Extract: Clutter-free extraction. Automatically creates a folder if loose files exist, or extracts directly if contents are already wrapped."
                               Margin="0,0,6,0" 
                               Padding="12,7">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Flash24" Margin="0,0,6,0" FontSize="15"/>
                            <TextBlock Text="Smart Extract" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Test / Audit Archive Button -->
                    <ui:Button x:Name="BtnTestArchive" 
                               Click="BtnTestArchive_Click"
                               Appearance="Secondary"
                               IsEnabled="False"
                               ToolTip="Test / Audit: streams and verifies all CRCs, headers, and flags corrupted files"
                               Margin="0,0,6,0" 
                               Padding="10,7">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" Margin="0,0,6,0" FontSize="15" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Text="Test / Audit" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Batch Queue Button -->
                    <ui:Button x:Name="BtnBatchQueue" 
                               Click="BtnBatchQueue_Click"
                               Appearance="Secondary"
                               ToolTip="Process, extract, or convert multiple archives in a batch queue"
                               Margin="0,0,6,0" 
                               Padding="10,7">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Stack24" Margin="0,0,6,0" FontSize="15"/>
                            <TextBlock Text="Batch Queue" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Benchmark Button -->
                    <ui:Button x:Name="BtnBenchmark" 
                               Click="BtnBenchmark_Click"
                               Appearance="Secondary"
                               ToolTip="Run multi-threaded hardware compression benchmark"
                               Margin="0,0,10,0" 
                               Padding="10,7">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Gauge24" Margin="0,0,6,0" FontSize="15"/>
                            <TextBlock Text="Benchmark" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Compare Archives Button (NEW - Not in WinRAR/7-Zip) -->
                    <ui:Button x:Name="BtnCompareArchives" 
                               Click="BtnCompareArchives_Click"
                               Appearance="Secondary"
                               ToolTip="Compare two archives side-by-side: shows files added, removed, modified, and identical"
                               Margin="0,0,6,0" 
                               Padding="10,7">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowSwap24" Margin="0,0,6,0" FontSize="15" Foreground="#FF9C27B0"/>
                            <TextBlock Text="Compare" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Size Analyzer Button (NEW - Not in WinRAR/7-Zip) -->
                    <ui:Button x:Name="BtnAnalyzeSize" 
                               Click="BtnAnalyzeSize_Click"
                               Appearance="Secondary"
                               IsEnabled="False"
                               ToolTip="Visual size analysis: see which files and folders consume the most space inside the archive"
                               Margin="0,0,6,0" 
                               Padding="10,7">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DataPie24" Margin="0,0,6,0" FontSize="15" Foreground="#FFFF9800"/>
                            <TextBlock Text="Analyze" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Convert Format Button (NEW - Not in WinRAR/7-Zip) -->
                    <ui:Button x:Name="BtnConvertFormat" 
                               Click="BtnConvertFormat_Click"
                               Appearance="Secondary"
                               IsEnabled="False"
                               ToolTip="One-click archive format conversion: ZIP ↔ 7Z with selectable compression level"
                               Margin="0,0,6,0" 
                               Padding="10,7">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowRepeatAll24" Margin="0,0,6,0" FontSize="15" Foreground="#FF4CAF50"/>
                            <TextBlock Text="Convert" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Checksum Verifier Button (NEW - Not in WinRAR/7-Zip) -->
                    <ui:Button x:Name="BtnChecksum" 
                               Click="BtnChecksum_Click"
                               Appearance="Secondary"
                               IsEnabled="False"
                               ToolTip="Calculate SHA-256, MD5, or SHA-1 checksum for the entire archive file and verify against expected hash"
                               Margin="0,0,10,0" 
                               Padding="10,7">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Fingerprint24" Margin="0,0,6,0" FontSize="15" Foreground="#FF2196F3"/>
                            <TextBlock Text="Checksum" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,4,10,4" />

                    <!-- Quick Archive Path Display -->
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" MaxWidth="240">
                        <TextBlock x:Name="TxtArchiveName" 
                                   Text="No archive loaded" 
                                   FontWeight="SemiBold" 
                                   FontSize="12.5" 
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="TxtArchivePath" 
                                   Text="Drag and drop files or click Open" 
                                   FontSize="10.5" 
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

                <!-- Search / Filter Input -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBox x:Name="TxtFilter" 
                                Width="180" 
                                PlaceholderText="Filter files..." 
                                TextChanged="TxtFilter_TextChanged"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Padding="8,5">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24" FontSize="14"/>
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <ui:Button x:Name="BtnCloseArchive" 
                               Click="BtnCloseArchive_Click"
                               Appearance="Transparent"
                               Visibility="Collapsed"
                               ToolTip="Close current archive"
                               Padding="8,7">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Main Content: Empty State vs (DataGrid + Inspector Panel) -->
        <Grid Grid.Row="2">
            <!-- Loaded Archive View: Summary Ribbon + Split Content (DataGrid & Inspector) -->
            <Grid x:Name="GridArchiveContent" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <!-- Info Ribbon -->
                    <RowDefinition Height="Auto" />
                    <!-- DataGrid + Inspector -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Metadata ribbon badges -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                        Padding="16,8" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="0,0,0,1">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Total Files -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8,4" 
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DocumentMultiple24" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtStatFiles" Text="0 files" FontSize="12" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Folders -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8,4" 
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Folder24" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtStatFolders" Text="0 folders" FontSize="12" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <!-- Uncompressed Size -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8,4" 
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="HardDrive24" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtStatSize" Text="0 B total" FontSize="12" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <!-- Compressed Size -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8,4" 
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="FolderZip24" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtStatPacked" Text="0 B packed" FontSize="12" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <!-- Smart Extract Tip Chip -->
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtSmartExtractMode" Text="Smart Extract active" FontSize="12" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Border>

                <!-- DataGrid & Inspector Split Layout -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Archive Items DataGrid -->
                    <DataGrid x:Name="DataGridFiles" 
                              Grid.Column="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              CanUserResizeColumns="True"
                              CanUserReorderColumns="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              SelectionChanged="DataGridFiles_SelectionChanged">
                        
                        <DataGrid.Columns>
                            <!-- Name with File Icon & Disguised Extension Warning Badge -->
                            <DataGridTemplateColumn Header="Name" Width="280" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ArchiveItemInfo}">
                                        <StackPanel Orientation="Horizontal" Margin="6,3" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="{Binding IconSymbol}" 
                                                           FontSize="16" 
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                                           Margin="0,0,8,0" 
                                                           VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" 
                                                       VerticalAlignment="Center" 
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <!-- Security Guard Warning Pill for Disguised Extensions -->
                                            <Border x:Name="BadgeDisguised" 
                                                    Background="#33E81123" 
                                                    BorderBrush="#FFE81123" 
                                                    BorderThickness="1" 
                                                    CornerRadius="4" 
                                                    Padding="5,1" 
                                                    Margin="8,0,0,0" 
                                                    ToolTip="{Binding DisguisedWarning}" 
                                                    Visibility="Collapsed">
                                                <TextBlock Text="⚠️ SUSPICIOUS EXTENSION" FontSize="9" FontWeight="Bold" Foreground="#FFFF6B6B"/>
                                            </Border>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasDisguisedExtension}" Value="True">
                                                <Setter TargetName="BadgeDisguised" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Type / Extension -->
                            <DataGridTextColumn Header="Type" 
                                                Binding="{Binding Extension}" 
                                                Width="75" 
                                                ElementStyle="{StaticResource {x:Type TextBlock}}"/>

                            <!-- Original Size -->
                            <DataGridTextColumn Header="Size" 
                                                Binding="{Binding FormattedSize}" 
                                                Width="95" 
                                                ElementStyle="{StaticResource {x:Type TextBlock}}"/>

                            <!-- Packed Size -->
                            <DataGridTextColumn Header="Packed" 
                                                Binding="{Binding FormattedCompressedSize}" 
                                                Width="95" 
                                                ElementStyle="{StaticResource {x:Type TextBlock}}"/>

                            <!-- Compression Ratio -->
                            <DataGridTextColumn Header="Ratio" 
                                                Binding="{Binding CompressionRatio}" 
                                                Width="75" 
                                                ElementStyle="{StaticResource {x:Type TextBlock}}"/>

                            <!-- Modified Date -->
                            <DataGridTextColumn Header="Modified" 
                                                Binding="{Binding FormattedModified}" 
                                                Width="140" 
                                                ElementStyle="{StaticResource {x:Type TextBlock}}"/>

                            <!-- Path / Subdirectory inside Archive -->
                            <DataGridTextColumn Header="Path" 
                                                Binding="{Binding Path}" 
                                                Width="*" 
                                                ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Right-Side Safety Preview / Inspector Panel -->
                    <Border x:Name="PanelInspector" 
                            Grid.Column="1" 
                            Width="360"
                            Visibility="Collapsed"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                            BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Inspector Header -->
                                <RowDefinition Height="Auto" />
                                <!-- Inspector Body (Image / Text / Security Warning) -->
                                <RowDefinition Height="*" />
                                <!-- Integrity / SHA-256 Footer -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 1. Inspector Header -->
                            <Border Grid.Row="0" 
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                    BorderThickness="0,0,0,1" 
                                    Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon x:Name="IconPreviewType" Symbol="Document24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock x:Name="TxtPreviewName" Text="preview_file.png" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                            <TextBlock x:Name="TxtPreviewSize" Text="12.4 KB • Image" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <ui:Button x:Name="BtnClosePreview" 
                                               Grid.Column="1" 
                                               Click="BtnClosePreview_Click" 
                                               Appearance="Transparent" 
                                               Padding="6,4">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                                    </ui:Button>
                                </Grid>
                            </Border>

                            <!-- 2. Inspector Content Body -->
                            <Grid Grid.Row="1" Margin="14">
                                <!-- Loading State -->
                                <StackPanel x:Name="PanelPreviewLoading" 
                                            Visibility="Collapsed" 
                                            VerticalAlignment="Center" 
                                            HorizontalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True" Width="140" Height="4" Margin="0,0,0,12"/>
                                    <TextBlock Text="Streaming preview into memory..." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Image Viewer -->
                                <Grid x:Name="PanelPreviewImage" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" 
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                            CornerRadius="8" 
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            Padding="6">
                                        <Image x:Name="ImgPreview" 
                                               Stretch="Uniform" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" 
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <TextBlock x:Name="TxtImageDimensions" 
                                               Grid.Row="1" 
                                               Text="Dimensions: 800 x 600" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               HorizontalAlignment="Center" 
                                               Margin="0,8,0,0"/>
                                </Grid>

                                <!-- Text / Code Viewer -->
                                <Grid x:Name="PanelPreviewText" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBox x:Name="TxtPreviewContent" 
                                             Grid.Row="0"
                                             IsReadOnly="True" 
                                             TextWrapping="Wrap" 
                                             AcceptsReturn="True" 
                                             VerticalScrollBarVisibility="Auto" 
                                             HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas, Cascadia Code, Courier New" 
                                             FontSize="11.5" 
                                             Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                             BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                             BorderThickness="1" 
                                             Padding="8"/>

                                    <TextBlock x:Name="TxtTextStats" 
                                               Grid.Row="1" 
                                               Text="Previewing first 256 KB" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                               Margin="0,6,0,0"/>
                                </Grid>

                                <!-- Executable Safety Warning Shield -->
                                <Grid x:Name="PanelPreviewSecurity" Visibility="Collapsed">
                                    <Border Background="#1AE81123" 
                                            BorderBrush="#66E81123" 
                                            BorderThickness="1.5" 
                                            CornerRadius="8" 
                                            Padding="16" 
                                            VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Background="#33E81123" 
                                                    CornerRadius="30" 
                                                    Width="56" 
                                                    Height="56" 
                                                    HorizontalAlignment="Center" 
                                                    Margin="0,0,0,12">
                                                <ui:SymbolIcon Symbol="ShieldError24" FontSize="30" Foreground="#FFE81123" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Text="Executable File" 
                                                       FontWeight="Bold" 
                                                       FontSize="15" 
                                                       Foreground="#FFFF6B6B" 
                                                       HorizontalAlignment="Center" 
                                                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Preview is disabled for security reasons." 
                                                       FontWeight="SemiBold" 
                                                       FontSize="12" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                       HorizontalAlignment="Center" 
                                                       Margin="0,0,0,6"/>

                                            <TextBlock Text="Executable binaries and scripts cannot be run directly from within the ZenArchive preview pane to protect your system from malware execution." 
                                                       FontSize="11" 
                                                       TextWrapping="Wrap" 
                                                       TextAlignment="Center" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                       LineHeight="16"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Generic File Info View -->
                                <Grid x:Name="PanelPreviewGeneric" Visibility="Collapsed">
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="16" 
                                            VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Document24" FontSize="44" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="Binary / Data File" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="No visual preview is available for this format." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- 3. Integrity Checksum (SHA-256) Section -->
                            <Border Grid.Row="2" 
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                    BorderThickness="0,1,0,0" 
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                    Padding="14,10">
                                <StackPanel Orientation="Vertical">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="SHA-256 Checksum" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                        <ui:Button x:Name="BtnCopyHash" 
                                                   Grid.Column="1" 
                                                   Click="BtnCopyHash_Click" 
                                                   Appearance="Transparent" 
                                                   ToolTip="Copy SHA-256 hash" 
                                                   Padding="6,2">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Copy24" FontSize="12" Margin="0,0,4,0"/>
                                                <TextBlock Text="Copy" FontSize="10.5"/>
                                            </StackPanel>
                                        </ui:Button>
                                    </Grid>
                                    
                                    <TextBox x:Name="TxtPreviewHash" 
                                             IsReadOnly="True" 
                                             Text="Calculating..." 
                                             FontFamily="Consolas" 
                                             FontSize="10" 
                                             TextWrapping="Wrap" 
                                             Background="Transparent" 
                                             BorderThickness="0" 
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Empty State / Drag & Drop Target -->
            <Grid x:Name="GridEmptyState" Visibility="Visible" Background="Transparent">
                <Border Margin="40,30" 
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="1.5" 
                        CornerRadius="12">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540">
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                CornerRadius="50" 
                                Width="88" 
                                Height="88" 
                                HorizontalAlignment="Center" 
                                Margin="0,0,0,20">
                            <ui:SymbolIcon Symbol="FolderZip24" 
                                           FontSize="44" 
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Open, Extract, or Create Archives" 
                                   FontSize="22" 
                                   FontWeight="SemiBold" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,8" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                        <TextBlock Text="Supports .zip, .rar, .7z, .tar, and .gz formats with Smart Extract, Previews &amp; AES-256" 
                                   FontSize="13" 
                                   HorizontalAlignment="Center" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   Margin="0,0,0,24" 
                                   TextAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Appearance="Primary" 
                                       Click="BtnOpenArchive_Click" 
                                       Margin="0,0,10,0"
                                       Padding="20,10">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,8,0" FontSize="16"/>
                                    <TextBlock Text="Open Archive" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Appearance="Secondary" 
                                       Click="BtnNewArchive_Click" 
                                       Margin="0,0,10,0"
                                       Padding="20,10">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="AddCircle24" Margin="0,0,8,0" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Create New" FontWeight="Medium" FontSize="13"/>
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Appearance="Secondary" 
                                       Click="BtnBatchQueue_Click" 
                                       Padding="20,10">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Stack24" Margin="0,0,8,0" FontSize="16"/>
                                    <TextBlock Text="Batch Queue" FontWeight="Medium" FontSize="13"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>

                        <TextBlock Text="or drag and drop archives or uncompressed files directly into this window" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Drag & Drop Hover Overlay -->
            <Border x:Name="BorderDragOverlay" 
                    Visibility="Collapsed" 
                    Background="#D90b111d" 
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" 
                    BorderThickness="3" 
                    CornerRadius="8" 
                    Margin="12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="56" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,16"/>
                    <TextBlock x:Name="TxtDragDropPrompt" 
                               Text="Drop files to open, create, or batch process in ZenArchive" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Modal: Create Archive Configuration Dialog -->
            <Grid x:Name="ModalCreateArchive" Visibility="Collapsed" Background="#C0070c14">
                <Border Width="540" 
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="1.5" 
                        CornerRadius="12" 
                        Padding="24"
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Header -->
                            <RowDefinition Height="Auto" />
                            <!-- Destination Path -->
                            <RowDefinition Height="Auto" />
                            <!-- Format & Compression Level -->
                            <RowDefinition Height="Auto" />
                            <!-- Password & Encryption Section -->
                            <RowDefinition Height="Auto" />
                            <!-- Source items list -->
                            <RowDefinition Height="Auto" />
                            <!-- Footer Buttons -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Modal Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Create New Archive" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Compress and optionally encrypt files into a clean archive" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Click="BtnCancelCreateModal_Click" Appearance="Transparent" Padding="6,4">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                            </ui:Button>
                        </Grid>

                        <!-- Output Location -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                            <TextBlock Text="Output Archive File" FontWeight="Medium" FontSize="12" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="TxtCreateArchivePath" Grid.Column="0" PlaceholderText="C:\Path\To\Archive.zip" Margin="0,0,8,0"/>
                                <ui:Button Grid.Column="1" Click="BtnBrowseCreateOutput_Click" Appearance="Secondary" Padding="12,6">
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="15"/>
                                </ui:Button>
                            </Grid>
                        </StackPanel>

                        <!-- Format & Compression Level Options -->
                        <Grid Grid.Row="2" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Archive Format" FontWeight="Medium" FontSize="12" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbCreateFormat" SelectedIndex="0" SelectionChanged="CmbCreateFormat_SelectionChanged" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="ZIP Archive (.zip)" Tag="Zip"/>
                                    <ComboBoxItem Content="7-Zip Archive (.7z)" Tag="SevenZip"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Compression Level" FontWeight="Medium" FontSize="12" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbCreateLevel" SelectedIndex="2" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Store (No compression)"/>
                                    <ComboBoxItem Content="Fast (Light compression)"/>
                                    <ComboBoxItem Content="Normal (Balanced)"/>
                                    <ComboBoxItem Content="Maximum (Smallest size)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Password Protection & Encryption Section -->
                        <Border Grid.Row="3" 
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="12,10" 
                                Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkEnablePassword" 
                                          Content="Enable AES-256 Password Encryption" 
                                          FontWeight="SemiBold" 
                                          Checked="ChkEnablePassword_CheckedChanged" 
                                          Unchecked="ChkEnablePassword_CheckedChanged" 
                                          Margin="0,0,0,6"/>

                                <StackPanel x:Name="PanelPasswordFields" Visibility="Collapsed" Margin="0,6,0,0">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Password" FontSize="11" Margin="0,0,0,4"/>
                                            <PasswordBox x:Name="TxtCreatePassword" 
                                                         PasswordChanged="TxtCreatePassword_PasswordChanged" 
                                                         Height="32"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Confirm Password" FontSize="11" Margin="0,0,0,4"/>
                                            <PasswordBox x:Name="TxtCreatePasswordConfirm" Height="32"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Live Password Strength Meter -->
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar x:Name="BarPasswordStrength" Grid.Column="0" Height="4" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtPasswordStrength" Grid.Column="1" Text="Strength: None" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </Grid>

                                    <!-- Encrypt file names for 7z -->
                                    <CheckBox x:Name="ChkEncryptFileNames" 
                                              Content="Encrypt File Names (Header encryption for .7z)" 
                                              FontSize="11.5" 
                                              IsEnabled="False"
                                              ToolTip="Encrypts the header structure so file names remain hidden until unlocked"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Source Items Summary -->
                        <StackPanel Grid.Row="4" Margin="0,0,0,18">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Items to Compress" FontWeight="Medium" FontSize="12" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:Button Click="BtnAddFilesToCreate_Click" Appearance="Transparent" Padding="6,2" Margin="0,0,4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="12" Margin="0,0,4,0"/>
                                            <TextBlock Text="+ Add Files" FontSize="11"/>
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Click="BtnAddFolderToCreate_Click" Appearance="Transparent" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="FolderAdd24" FontSize="12" Margin="0,0,4,0"/>
                                            <TextBlock Text="+ Add Folder" FontSize="11"/>
                                        </StackPanel>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="6">
                                <ListBox x:Name="ListSourceItems" 
                                         MaxHeight="100" 
                                         Background="Transparent" 
                                         BorderThickness="0" 
                                         FontSize="11.5"/>
                            </Border>
                        </StackPanel>

                        <!-- Modal Actions Footer -->
                        <Grid Grid.Row="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:Button Grid.Column="0" Click="BtnCancelCreateModal_Click" Appearance="Secondary" Content="Cancel" HorizontalAlignment="Left" Padding="16,7"/>
                            <ui:Button Grid.Column="1" Click="BtnStartCreateArchive_Click" Appearance="Primary" Padding="20,7">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Flash24" Margin="0,0,8,0" FontSize="16"/>
                                    <TextBlock Text="Create Archive" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Modal: Password Prompt Dialog for Encrypted Archives -->
            <Grid x:Name="ModalPasswordPrompt" Visibility="Collapsed" Background="#D9070c14">
                <Border Width="420" 
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="1.5" 
                        CornerRadius="12" 
                        Padding="24"
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                    CornerRadius="20" 
                                    Width="40" 
                                    Height="40" 
                                    Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Encrypted Archive" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Password required to decrypt content" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="TxtPasswordPromptMessage" 
                                   Text="This archive is protected with AES-256 encryption. Please enter the password to proceed:" 
                                   FontSize="12" 
                                   TextWrapping="Wrap" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                   Margin="0,0,0,12"/>

                        <PasswordBox x:Name="TxtDecryptPassword" 
                                     Height="36" 
                                     Margin="0,0,0,18" 
                                     KeyDown="TxtDecryptPassword_KeyDown"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:Button Grid.Column="0" 
                                       Click="BtnCancelPasswordPrompt_Click" 
                                       Appearance="Secondary" 
                                       Content="Cancel" 
                                       HorizontalAlignment="Left" 
                                       Padding="16,7"/>

                            <ui:Button Grid.Column="1" 
                                       Click="BtnSubmitPassword_Click" 
                                       Appearance="Primary" 
                                       Padding="20,7">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Key24" Margin="0,0,6,0" FontSize="15"/>
                                    <TextBlock Text="Unlock" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Modal: Health Report / Diagnostic Audit Overlay -->
            <Grid x:Name="ModalHealthReport" Visibility="Collapsed" Background="#D9070c14">
                <Border Width="520" 
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="1.5" 
                        CornerRadius="12" 
                        Padding="24"
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Archive Health &amp; Integrity Audit" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="CRC32, SHA-256 and structure verification" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Click="BtnCloseHealthReport_Click" Appearance="Transparent" Padding="6,4">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                            </ui:Button>
                        </Grid>

                        <!-- Health Status Banner -->
                        <Border x:Name="BorderHealthStatus" 
                                Background="#1A107C41" 
                                BorderBrush="#66107C41" 
                                BorderThickness="1.5" 
                                CornerRadius="8" 
                                Padding="16,12" 
                                Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon x:Name="IconHealthStatus" Symbol="CheckmarkCircle24" FontSize="26" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtHealthStatusTitle" Text="100% HEALTHY - ALL CHECKS PASSED" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                    <TextBlock x:Name="TxtHealthStatusDesc" Text="All entries decompressed cleanly with zero CRC errors or corruptions." FontSize="11.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Audit Statistics Grid -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Tested Files" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtHealthTestedFiles" Text="0 files" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Audit Speed" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtHealthSpeed" Text="0 MB/s" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="Elapsed Time" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtHealthElapsed" Text="0.0s" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Issues Box (if any) -->
                        <StackPanel x:Name="PanelHealthIssues" Visibility="Collapsed" Margin="0,0,0,16">
                            <TextBlock Text="Corrupt / Problem Entries:" FontWeight="SemiBold" FontSize="12" Foreground="#FFFF6B6B" Margin="0,0,0,6"/>
                            <Border Background="#1AE81123" BorderBrush="#66E81123" BorderThickness="1" CornerRadius="6" Padding="8" MaxHeight="120">
                                <ListBox x:Name="ListHealthIssues" Background="Transparent" BorderThickness="0" FontSize="11"/>
                            </Border>
                        </StackPanel>

                        <!-- Action Button -->
                        <ui:Button Click="BtnCloseHealthReport_Click" Appearance="Primary" Content="Dismiss" HorizontalAlignment="Right" Padding="20,7"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Modal: Hardware Benchmark Dashboard -->
            <Grid x:Name="ModalBenchmark" Visibility="Collapsed" Background="#D9070c14">
                <Border Width="540" 
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="1.5" 
                        CornerRadius="12" 
                        Padding="24"
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Hardware Compression Benchmark" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Multi-threaded synthetic workload performance test" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Click="BtnCloseBenchmark_Click" Appearance="Transparent" Padding="6,4">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                            </ui:Button>
                        </Grid>

                        <!-- Glowing Score Card -->
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" 
                                BorderThickness="1.5" 
                                CornerRadius="10" 
                                Padding="20,16" 
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ZenScore Rating" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtBenchmarkScore" Text="Ready" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtBenchmarkTier" Text="Press 'Run Test' to evaluate hardware" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="30" Width="60" Height="60">
                                    <ui:SymbolIcon Symbol="Gauge24" FontSize="30" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Throughput Results -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Compression" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtBenchCompression" Text="-" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Decompression" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtBenchDecompression" Text="-" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="CPU Cores" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtBenchCores" Text="-" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Live Test Progress Bar -->
                        <ProgressBar x:Name="ProgressBenchmark" Height="4" Minimum="0" Maximum="100" Value="0" Visibility="Hidden" Margin="0,0,0,16"/>

                        <!-- Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Click="BtnCloseBenchmark_Click" Appearance="Secondary" Content="Close" HorizontalAlignment="Left" Padding="16,7"/>
                            <ui:Button x:Name="BtnRunBenchmarkAction" Grid.Column="1" Click="BtnRunBenchmarkAction_Click" Appearance="Primary" Padding="20,7">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play24" Margin="0,0,6,0" FontSize="15"/>
                                    <TextBlock Text="Run Benchmark" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Modal: Batch Archive Processing Queue -->
            <Grid x:Name="ModalBatchQueue" Visibility="Collapsed" Background="#D9070c14">
                <Border Width="600" 
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                        BorderThickness="1.5" 
                        CornerRadius="12" 
                        Padding="24"
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Header -->
                            <RowDefinition Height="Auto" />
                            <!-- Queue List -->
                            <RowDefinition Height="Auto" />
                            <!-- Batch Options -->
                            <RowDefinition Height="Auto" />
                            <!-- Dual Progress -->
                            <RowDefinition Height="Auto" />
                            <!-- Footer -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Batch Archive Processing Queue" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Process, smart-extract, or convert multiple archives at once" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Click="BtnCloseBatchQueue_Click" Appearance="Transparent" Padding="6,4">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                            </ui:Button>
                        </Grid>

                        <!-- Queue List -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Queued Archives" FontWeight="Medium" FontSize="12" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:Button Click="BtnAddArchivesToBatch_Click" Appearance="Transparent" Padding="6,2" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="FolderAdd24" FontSize="12" Margin="0,0,4,0"/>
                                            <TextBlock Text="+ Add Archives" FontSize="11"/>
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Click="BtnClearBatchQueue_Click" Appearance="Transparent" Padding="6,2">
                                        <TextBlock Text="Clear All" FontSize="11"/>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    MaxHeight="120">
                                <ListBox x:Name="ListBatchArchives" 
                                         Background="Transparent" 
                                         BorderThickness="0" 
                                         FontSize="11.5"/>
                            </Border>
                        </StackPanel>

                        <!-- Batch Action Options -->
                        <Grid Grid.Row="2" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Batch Operation" FontWeight="Medium" FontSize="12" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbBatchOperation" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Smart Extract All (Individual Folders)"/>
                                    <ComboBoxItem Content="Convert All to ZIP (.zip)"/>
                                    <ComboBoxItem Content="Convert All to 7-Zip (.7z)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Destination Root Folder" FontWeight="Medium" FontSize="12" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtBatchDestination" Grid.Column="0" PlaceholderText="Select folder..." Margin="0,0,6,0"/>
                                    <ui:Button Grid.Column="1" Click="BtnBrowseBatchDestination_Click" Appearance="Secondary" Padding="10,5">
                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14"/>
                                    </ui:Button>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Dual Progress Bars -->
                        <StackPanel Grid.Row="3" x:Name="PanelBatchProgress" Visibility="Collapsed" Margin="0,0,0,16">
                            <Grid Margin="0,0,0,4">
                                <TextBlock x:Name="TxtBatchOverallStatus" Text="Overall Queue Progress: 0/0" FontSize="11" FontWeight="Medium"/>
                                <TextBlock x:Name="TxtBatchOverallPercent" Text="0%" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="BarBatchOverall" Height="5" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,4">
                                <TextBlock x:Name="TxtBatchItemStatus" Text="Current Archive..." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TxtBatchItemPercent" Text="0%" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="BarBatchItem" Height="3" Minimum="0" Maximum="100" Value="0"/>
                        </StackPanel>

                        <!-- Footer Actions -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Click="BtnCloseBatchQueue_Click" Appearance="Secondary" Content="Close" HorizontalAlignment="Left" Padding="16,7"/>
                            <ui:Button x:Name="BtnStartBatchAction" Grid.Column="1" Click="BtnStartBatchAction_Click" Appearance="Primary" Padding="20,7">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play24" Margin="0,0,6,0" FontSize="15"/>
                                    <TextBlock Text="Start Batch Queue" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 4. Bottom Status & Progress Section -->
        <Border Grid.Row="3" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="16,10,16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status line & Action buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status Text -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon x:Name="IconStatus" 
                                       Symbol="CheckmarkCircle24" 
                                       FontSize="15" 
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" 
                                       Margin="0,0,8,0" 
                                       VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatus" 
                                   Text="Ready" 
                                   FontSize="12" 
                                   FontWeight="Medium" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Extra action buttons / info -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Percentage text -->
                        <TextBlock x:Name="TxtProgressPercent" 
                                   Text="" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                   Margin="0,0,12,0" 
                                   VerticalAlignment="Center"/>

                        <!-- Open Extracted Folder Button -->
                        <ui:Button x:Name="BtnOpenDestinationFolder" 
                                   Click="BtnOpenDestinationFolder_Click" 
                                   Appearance="Secondary" 
                                   Visibility="Collapsed" 
                                   Padding="10,4" 
                                   Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" FontSize="14"/>
                                <TextBlock Text="Open Destination Folder" FontSize="12"/>
                            </StackPanel>
                        </ui:Button>

                        <!-- Cancel Operation Button -->
                        <ui:Button x:Name="BtnCancelOperation" 
                                   Click="BtnCancelOperation_Click" 
                                   Appearance="Danger" 
                                   Visibility="Collapsed" 
                                   Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" FontSize="14"/>
                                <TextBlock Text="Cancel" FontSize="12"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- Modern Progress Bar -->
                <ProgressBar x:Name="ProgressBarOperation" 
                             Grid.Row="1" 
                             Height="4" 
                             Minimum="0" 
                             Maximum="100" 
                             Value="0" 
                             Visibility="Hidden"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
