<ui:FluentWindow x:Class="Archieve_App.ExtractionProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Extracting - ZenArchive" 
        Height="290" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar Row -->
            <RowDefinition Height="*"/>    <!-- Main Extraction Content -->
        </Grid.RowDefinitions>

        <!-- Native Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="ZenArchive" Height="36" Padding="14,0,8,0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="FolderZip24" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="ZenArchive • Extraction" FontWeight="Medium" FontSize="12"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="20,8,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Archive & Destination info -->
                <RowDefinition Height="*"/>    <!-- Progress, Password or Completion -->
                <RowDefinition Height="Auto"/> <!-- Bottom Buttons & Options -->
            </Grid.RowDefinitions>

            <!-- Header: Archive Name & Target Destination -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" 
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Archive24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtArchiveName" Text="Archive.zip" 
                               FontWeight="SemiBold" FontSize="14" 
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtDestinationPath" Text="Extracting to: C:\Users\..." 
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" 
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Central Area 1: Active Progress View -->
            <Grid x:Name="PanelProgressView" Grid.Row="1" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Current file being extracted -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Extracting: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="TxtCurrentFile" Grid.Column="1" Text="Preparing..." 
                                   FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- Modern Progress Bar -->
                    <ProgressBar x:Name="ProgressBarExtraction" Height="8" Margin="0,4,0,8" 
                                 Minimum="0" Maximum="100" Value="0"/>

                    <!-- Metrics Row: Percentage, File Count, Speed, Elapsed -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock x:Name="TxtPercent" Text="0%" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text=" • " Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="4,0,4,0"/>
                            <TextBlock x:Name="TxtItemCount" Text="0 files" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="TxtSpeed" Text="0.0 MB/s" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text=" • " Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="4,0,4,0"/>
                            <TextBlock x:Name="TxtElapsed" Text="00:00" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Central Area 2: In-Dialog Password Prompt View (Shown if encrypted) -->
            <Border x:Name="PanelPasswordView" Grid.Row="1" Visibility="Collapsed"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Password Required (AES-256)" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="TxtPasswordInput" Grid.Column="0" Height="32" 
                                     KeyDown="TxtPasswordInput_KeyDown"
                                     VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                        <ui:Button x:Name="BtnSubmitPassword" Grid.Column="1" Content="Unlock" 
                                   Appearance="Primary" Height="32" Click="BtnSubmitPassword_Click"/>
                    </Grid>

                    <TextBlock x:Name="TxtPasswordError" Text="" 
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" 
                               FontSize="11" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Central Area 3: Completion View (Shown if Close When Finished is unchecked) -->
            <Border x:Name="PanelCompletionView" Grid.Row="1" Visibility="Collapsed"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="CheckmarkCircle24" FontSize="28" 
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Extraction Complete!" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="TxtCompletionSummary" Text="All files extracted successfully." 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ui:Button Grid.Column="2" Content="Open Folder" Appearance="Primary" 
                               Click="BtnOpenFolder_Click" Margin="6,0,0,0"/>
                </Grid>
            </Border>

            <!-- Bottom Row: Options & Action Buttons -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 7-Zip Style 'Close when finished' Checkbox -->
                <CheckBox x:Name="ChkCloseWhenFinished" Grid.Column="0" 
                          Content="Close when finished" IsChecked="True" 
                          VerticalAlignment="Center" FontSize="12"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="BtnBackground" 
                               Click="BtnBackground_Click" Height="32" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowDownLeft24" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Run in Background" FontSize="12"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="BtnCancel" Content="Cancel" 
                               Click="BtnCancel_Click" Height="32" Width="75"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
